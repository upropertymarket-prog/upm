# Supabase local (supabase start imprime estes valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: Edge Functions, webhooks e mail-worker. Nunca no cliente (02 §3.3).
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (02 §3.2)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Fase 3 — URLs cruzadas entre apps (03 §1.1)
WEB_URL=http://localhost:4300
APP_URL=http://localhost:4301
INTERNO_URL=http://localhost:4302

# Fase 3 — opcional, só em produção (partilha o cookie de sessão entre
# subdomínios: www, app.*, interno.*). Sem valor em dev local.
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
