# Supabase local (supabase start imprime estes valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: Edge Functions, webhooks e mail-worker. Nunca no cliente (02 §3.3).
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (02 §3.2)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
