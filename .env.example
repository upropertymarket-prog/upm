# Supabase local (supabase start imprime estes valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor, nunca no cliente (02 §3.3). As TRÊS apps precisam dela, e o
# mail-worker: o `www` para o registo (elegibilidade) e para o limite de
# tentativas de entrada, registo e recuperação (A15 — sem ela, o limite falha
# aberto e o registo diz "temporariamente indisponível"); o `app` para o
# webhook do Stripe e a eliminação de conta; o `interno` para a entrada e o
# step-up. Onde cada uso é permitido: `scripts/gate/check-server-boundary.mjs`.
SUPABASE_SERVICE_ROLE_KEY=

# Sentry (02 §3.2)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Fase 3 — URLs cruzadas entre apps (03 §1.1)
WEB_URL=http://localhost:4300
APP_URL=http://localhost:4301
INTERNO_URL=http://localhost:4302

# Fase 7 — Stripe (02 §9). Em dev usam-se SEMPRE chaves de teste (sk_test_…);
# as chaves live, os produtos reais e o endpoint de webhook em produção são
# confirmação de produção e ficam para o fim do projeto (07 §16.1).
# Nenhuma delas leva prefixo NEXT_PUBLIC_ (08 §6.1).
STRIPE_SECRET_KEY=
# Impresso por `stripe listen --forward-to localhost:4301/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# Fase 10 — mail-worker (P10-03). O worker corre fora das apps Next: lê as
# caixas IMAP do Suporte e drena a fila de notificações pelo Resend. A
# `SUPABASE_SERVICE_ROLE_KEY` acima é a chave que ele usa — e a única razão por
# que existe fora de Edge Functions e webhooks (02 §3.3).
#
# O token é partilhado entre o worker e o `apps/interno`: é o que autoriza o
# botão "Testar ligação" de /admin/caixas-email. Gere-se com
# `openssl rand -hex 32` e nunca leva prefixo NEXT_PUBLIC_.
MAIL_WORKER_URL=http://localhost:8080
MAIL_WORKER_TOKEN=
# Relay de saída (07 §24.2). Enquanto o domínio não estiver verificado no
# Resend, só entrega de onboarding@resend.dev e só para o e-mail da conta — o
# domínio dedicado (mail.upropertymarket.pt) é confirmação de produção (07 §16.1).
RESEND_API_KEY=
MAIL_FROM=UProperty Market <onboarding@resend.dev>
# Campanhas (P10-08). O worker entrega-as pelo Resend, por lotes, e precisa de
# saber onde vive o site público: o link de cancelar subscrição que 02 §4.3
# exige abre **sem sessão**, logo não pode apontar para a app autenticada.
WEB_URL=http://localhost:4300
# Por omissão o remetente é o nome e o endereço da caixa escolhida no construtor
# (07 §24.6 #2). Esta variável sobrepõe-se a isso, e existe só para o período em
# que o domínio `news.` não está verificado no Resend — que recusa qualquer
# `from` que não seja de um domínio dele. Confirmação de produção (07 §16.1).
CAMPAIGN_FROM=
# Recibos (P10-09). O Resend assina os webhooks ao estilo Svix e o worker
# verifica a assinatura com este segredo, em `POST /resend-webhook`. **Sem ele o
# endpoint recusa tudo** — um endpoint que escreve métricas a partir de qualquer
# pedido é um endpoint que qualquer pessoa pode usar para inventar aberturas.
RESEND_WEBHOOK_SECRET=

# Fase 3 — opcional, só em produção (partilha o cookie de sessão entre
# subdomínios: www, app.*, interno.*). Sem valor em dev local.
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
