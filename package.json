{
  "name": "upropertymarket",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "db:types": "supabase gen types typescript --linked > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "gate": "node scripts/gate/check-public-env.mjs && node scripts/gate/check-client-bundle.mjs && node scripts/gate/check-responsive.mjs && pnpm gate:typography && pnpm gate:links && pnpm gate:canvas && pnpm gate:seo && pnpm gate:i18n && pnpm gate:rls && pnpm gate:server && pnpm gate:rotas && pnpm gate:db && pnpm gate:deps",
    "gate:env": "node scripts/gate/check-public-env.mjs",
    "gate:i18n": "node scripts/gate/check-i18n.mjs",
    "gate:bundle": "node scripts/gate/check-client-bundle.mjs",
    "gate:responsive": "node scripts/gate/check-responsive.mjs",
    "gate:typography": "node scripts/gate/check-typography.mjs",
    "gate:typography:test": "node scripts/gate/check-typography.test.mjs",
    "gate:links": "node scripts/gate/check-dead-links.mjs",
    "gate:links:test": "node scripts/gate/check-dead-links.test.mjs",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "gate:rls": "node scripts/gate/check-rls.mjs",
    "gate:rls:test": "node scripts/gate/check-rls.test.mjs",
    "gate:server": "node scripts/gate/check-server-boundary.mjs",
    "gate:server:test": "node scripts/gate/check-server-boundary.test.mjs",
    "gate:rotas": "node scripts/gate/check-route-roles.mjs",
    "gate:rotas:test": "node scripts/gate/check-route-roles.test.mjs",
    "gate:db": "supabase db lint --linked --schema public --level warning --fail-on error",
    "gate:deps": "pnpm audit --audit-level high",
    "create-staff-user": "node scripts/create-staff-user.mjs",
    "stripe:sync": "tsx scripts/stripe/sync-catalog.ts",
    "stripe:reconcile": "tsx scripts/stripe/reconcile.ts",
    "analytics:import": "tsx scripts/analytics/import-daily.ts",
    "gate:seo": "node scripts/generate-seo-routes.mjs --check && node scripts/gate/check-seo.mjs",
    "seo:routes": "node scripts/generate-seo-routes.mjs",
    "gate:canvas": "node scripts/gate/check-canvas.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.47.10",
    "prettier": "^3.4.2",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "markdown-it": ">=14.3.3",
      "postcss": ">=8.5.18",
      "rollup": ">=3.30.0",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "vite": ">=8.3.3"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  }
}
